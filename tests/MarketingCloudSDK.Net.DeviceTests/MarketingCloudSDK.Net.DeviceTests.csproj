<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Which of the package's target frameworks to exercise. Overriding TargetFramework directly
      on the command line breaks restore, so it goes through a property of our own.

      One project with two heads, not two projects: the point of this suite is that the same
      checks compile and pass on both platforms, and two projects sharing a linked file would
      make it possible for one of them to drift.
    -->
    <SfmcDeviceTargetFramework Condition=" '$(SfmcDeviceTargetFramework)' == '' ">net9.0-ios18.0</SfmcDeviceTargetFramework>
    <TargetFramework>$(SfmcDeviceTargetFramework)</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <CheckEolWorkloads>false</CheckEolWorkloads>
    <!-- The AndroidX exact-range disagreements inside the MobilePush binding's graph; see the
         note in src/Sfmc.Facade.props. -->
    <NoWarn>$(NoWarn);NU1608</NoWarn>

    <ApplicationId>com.sbokatuk.mcnet.devicetests</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <SupportedOSPlatformVersion>12.2</SupportedOSPlatformVersion>
    <!--
      The checks report through stdout, which the runner streams back with `simctl launch` in
      console-pty mode. Quietening the Mono logger keeps that stream to the test output rather
      than runtime chatter.
    -->
    <MtouchExtraArgs>--setenv=MONO_LOG_LEVEL=error</MtouchExtraArgs>

    <!--
      The interpreter, explicitly. The .NET 9 iOS SDK JITs a Debug simulator build; the .NET 8
      one puts the runtime in aot-only mode for the same command line, and then dies on the first
      assembly it has no AOT image for. Setting it for both bands rather than only net8 keeps the
      two runs comparable - a check that passes under the interpreter on one band and under the
      JIT on another is not testing quite the same thing.
    -->
    <UseInterpreter>true</UseInterpreter>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <!-- The MobilePush SDK's own floor - the .aar manifests declare 26. -->
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>

    <!--
      The property, not an @(AndroidManifest) item, and an explicit file rather than none at all.
      The .NET 9 and .NET 10 Android SDKs generate a manifest when the project has no
      $(AndroidManifest); the .NET 8 one defaults the property to the project root and then fails
      with XA1018 because nothing is there. Only surfaces on the net8 leg of the e2e matrix.
    -->
    <AndroidManifest>Platforms/Android/AndroidManifest.xml</AndroidManifest>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Platforms/**/*.cs" />
    <None Include="Platforms/**/*.cs" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <Compile Include="Platforms/Android/**/*.cs" />
    <None Remove="Platforms/Android/**/*.cs" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <Compile Include="Platforms/iOS/**/*.cs" />
    <None Remove="Platforms/iOS/**/*.cs" />
  </ItemGroup>

  <!--
    The device tests deliberately consume the packed MarketingCloudSDK.Net from ./artifacts
    rather than a ProjectReference, so they exercise the artifact that actually gets published -
    including its exact-pinned dependencies on MarketingCloudSDK.Net.Android /
    MarketingCloudSDK.Net.iOS and SFMCSDK.Net, which arrive TRANSITIVELY here on purpose: the
    dependency groups the merge step writes are the part a ProjectReference (or a direct binding
    reference) would prove nothing about. See NuGet.config for the local feed.
  -->
  <PropertyGroup>
    <SfmcPackageVersion Condition=" '$(SfmcPackageVersion)' == '' ">$(VersionPrefix)</SfmcPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MarketingCloudSDK.Net" Version="$(SfmcPackageVersion)" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <!--
      The 2026 AndroidX generation splits Compose.Runtime.Annotation into -Android (.aar) and
      -Jvm (.jar) flavors, and the transitive graph resolves BOTH - each carrying the same
      classes, which D8 refuses to dex (Type ... is defined multiple times). Keeping the package
      in the graph but excluding its assets drops the duplicate .jar; Android apps want the
      .android flavor. The same line belongs in any consuming app that hits JAVA0000 on
      androidx.compose.runtime.annotation types - see the README's troubleshooting section.
    -->
    <PackageReference Include="Xamarin.AndroidX.Compose.Runtime.Annotation.Jvm" Version="1.9.5" ExcludeAssets="all" />
  </ItemGroup>

</Project>
