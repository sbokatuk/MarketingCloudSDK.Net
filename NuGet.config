<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!--
      Locally packed packages. Three things resolve from here: the MarketingCloudSDK.Net the
      Maui layer, the device tests and the sample consume - the packed .nupkg rather than the
      project, so all of them run against exactly what gets published, dependency groups
      included - the MarketingCloudSDK.Net.Maui the sample consumes the same way, and, during
      local development against unreleased dependencies, the MarketingCloudSDK.Net.Android /
      MarketingCloudSDK.Net.iOS / SFMCSDK.Net packages the sibling repositories' own
      BuildNugets.sh dropped in ./artifacts. On a clean clone those come from nuget.org instead;
      the pins in Directory.Build.props resolve identically either way.
    -->
    <add key="local-artifacts" value="artifacts" />
  </packageSources>
</configuration>
