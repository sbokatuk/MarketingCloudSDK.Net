<Project>

  <!--
    Everything the façade package shares with any future sibling shaped like it, so the .csproj is
    its identity and its dependencies. Imported explicitly rather than being a
    Directory.Build.props of its own, so that the tests and the sample - which live outside src/
    and are not packages - do not pick any of it up.

    MarketingCloudSDK.Net.Maui deliberately does NOT import this file: it is a thin MAUI layer
    whose target frameworks are the platform ones only (a MAUI builder extension has no neutral
    leg to offer) and whose compile inputs are two shared files with no Platforms/ split, so
    nearly everything below would have to be undone there. It carries its own equivalents.
  -->

  <PropertyGroup>
    <TargetFrameworks>$(SfmcNeutralTargetFrameworks);$(SfmcAndroidTargetFrameworks);$(SfmcIosTargetFrameworks)</TargetFrameworks>
    <IsPackable>true</IsPackable>

    <!--
      Note what is deliberately *not* suppressed: CS1591, the missing-documentation warning. The
      public API is the product here, so an undocumented public member is a defect rather than a
      style preference - GenerateDocumentationFile in Directory.Build.props turns it on and
      TreatWarningsAsErrors makes it fatal.

      NU1608 is a property of the AndroidX graph the MarketingCloud Android binding pulls in, not
      of anything this repository does: exact-ranged AndroidX packages inside that graph disagree
      with siblings that float past them, NuGet resolves the higher version, warns, and produces
      a working app - which is why MarketingCloudSDK.Net.Android ships against exactly this set
      and its emulator tests pass. Suppressed rather than pinned: pinning the AndroidX versions
      here would turn them into dependencies of MarketingCloudSDK.Net and force that generation
      on every consumer - precisely the mistake the binding repositories' READMEs warn against. A
      consuming app that wants the warning gone can pin them itself.

      NU5104 is the prerelease-dependency warning, which fires for the -beta packages a pull
      request builds against.
    -->
    <NoWarn>$(NoWarn);NU5104;NU1608</NoWarn>

    <!--
      Trim and AOT analyzers on every head, not only where the mobile SDKs default them on. The
      shared sources are deliberately reflection-free, and the analyzers are what keep that true
      as the code moves - TreatWarningsAsErrors makes a regression fail the build rather than a
      consumer's trimmed app. IsTrimmable is deliberately NOT claimed, matching the binding
      repositories' stance: how the platform heads behave under aggressive trimming is the native
      bindings' story, and a marker that invites the trimmer in is a promise this layer alone
      cannot keep.
    -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <SupportedOSPlatformVersion>$(SfmcSupportedIosVersion)</SupportedOSPlatformVersion>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <SupportedOSPlatformVersion>$(SfmcSupportedAndroidVersion)</SupportedOSPlatformVersion>

    <!--
      This is a code-only library with no Android resources, so the generated Resource designer
      has nothing to describe - and generating it is actively harmful here: it is emitted into
      $(RootNamespace), where a type named after the project collides with the namespace and
      fails the build with CS0101 pointing at a file with no second definition in it.
      AndroidUseDesignerAssembly stays at its default of true: the MarketingCloud Android binding
      package itself uses the designer assembly, and turning it off fails with XA1034.
    -->
    <AndroidGenerateResourceDesigner>false</AndroidGenerateResourceDesigner>
  </PropertyGroup>

  <!--
    One implementation directory per target platform, and exactly one of them compiled into any
    given assembly. The shared sources declare the public API and every `partial` seam; the
    directory selected below supplies the bodies.

    The default glob picks up everything under the project, so Platforms/ is removed first and the
    matching subtree added back. A target framework that matched none of the conditions below
    would fail to compile with "no defining declaration found for implementing declaration",
    which is the intended outcome: silently producing an assembly whose API does nothing would be
    worse.
  -->
  <ItemGroup>
    <Compile Remove="Platforms/**/*.cs" />
    <None Include="Platforms/**/*.cs" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <Compile Include="Platforms/Android/**/*.cs" />
    <None Remove="Platforms/Android/**/*.cs" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <Compile Include="Platforms/Apple/**/*.cs" />
    <None Remove="Platforms/Apple/**/*.cs" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == ''">
    <Compile Include="Platforms/Neutral/**/*.cs" />
    <None Remove="Platforms/Neutral/**/*.cs" />
  </ItemGroup>

  <!--
    Icon, README and the licence text. Only the MIT text is packed: this package ships no native
    binaries, so unlike the binding packages there is no BSD-3-Clause payload for it to declare -
    Salesforce's licence arrives with the binding packages themselves, each of which packs both
    texts. See the licence note in Directory.Build.props.
  -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../build/icon.png" Pack="true" PackagePath="" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../LICENSE" Pack="true" PackagePath="licenses/" Visible="false" />
  </ItemGroup>

</Project>
